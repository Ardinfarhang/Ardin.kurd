<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>ardin.farhang — Indie Arcade Edition</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#080b16;color:#fff;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh;display:grid;place-items:center;overflow:hidden}
.app{width:min(100%,1100px);min-height:100vh;padding:28px;display:flex;flex-direction:column}
header{display:flex;justify-content:space-between;align-items:center;gap:20px}
.brand{font-weight:900;letter-spacing:.5px;font-size:clamp(24px,4vw,42px)}.edition{font-size:12px;opacity:.55;letter-spacing:2px;text-transform:uppercase}
.speed{border:1px solid #2a3150;border-radius:999px;padding:10px 15px;background:#10162a;color:#aeb8d8;font-weight:700}
main{flex:1;display:grid;place-items:center}.card{width:min(100%,760px);text-align:center}
h1{font-size:clamp(42px,8vw,82px);margin:0 0 8px;line-height:1;font-weight:950}
.sub{color:#9da7c6;font-size:clamp(15px,2vw,19px);margin:0 auto 28px;max-width:560px}
.stats{display:flex;justify-content:center;gap:14px;margin-bottom:22px}.stat{background:#11172a;border:1px solid #252d49;border-radius:16px;padding:12px 24px;min-width:130px}.stat small{display:block;color:#7e89aa;font-size:11px;letter-spacing:1.5px}.stat b{font-size:26px}
button{border:0;cursor:pointer;font:inherit;font-weight:900;border-radius:15px;padding:16px 30px;background:#fff;color:#080b16;box-shadow:0 8px 25px #0005;transition:.15s}button:hover{transform:translateY(-2px)}button.secondary{background:#171e34;color:#fff;border:1px solid #303a5d}
.hint{margin-top:18px;color:#697596;font-size:13px}
.game{display:none;position:relative;width:min(92vw,700px);height:min(68vh,560px);min-height:400px;border:1px solid #30395b;border-radius:25px;overflow:hidden;background:linear-gradient(#18274c,#4e7bb3 65%,#6c9b50 65%,#355c32)}
canvas{width:100%;height:100%;display:block}.hud{position:absolute;top:15px;left:15px;right:15px;display:flex;justify-content:space-between;pointer-events:none}.pill{background:#080b16aa;border:1px solid #ffffff22;border-radius:999px;padding:8px 13px;font-weight:800}
.overlay{position:absolute;inset:0;display:none;place-items:center;background:#05081799;text-align:center;padding:20px}.overlayBox{background:#0e1427ee;border:1px solid #30395b;border-radius:22px;padding:28px;min-width:min(90%,360px)}.overlay h2{font-size:38px;margin:0 0 8px}.overlay p{color:#9da7c6;margin:0 0 20px}.actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
footer{text-align:center;color:#59627e;font-size:12px;padding-top:18px}
@media(max-width:600px){.app{padding:18px}.stats{gap:8px}.stat{min-width:100px;padding:10px}.game{min-height:420px;height:65vh}}
</style>
</head>
<body>
<div class="app">
<header><div><div class="brand">ardin.farhang</div><div class="edition">Indie Arcade Edition</div></div><div class="speed">0 Speed · 1x</div></header>
<main>
<section class="card" id="home">
<h1>Welcome Player</h1>
<p class="sub">Flap your wings, dodge the obstacles, and achieve the ultimate high score!</p>
<div class="stats"><div class="stat"><small>HIGH SCORE</small><b id="homeBest">0</b></div></div>
<button id="play">PLAY GAME</button>
<div class="hint">Tap / Click or press Space to fly</div>
</section>
<section class="game" id="game">
<canvas id="canvas"></canvas>
<div class="hud"><div class="pill">SCORE: <span id="score">0</span></div><div class="pill">BEST: <span id="best">0</span></div></div>
<div class="overlay" id="overlay"><div class="overlayBox"><h2 id="overTitle">GAME OVER</h2><p id="overText">Score: 0</p><div class="actions"><button id="again">PLAY AGAIN</button><button class="secondary" id="menu">MENU</button></div></div></div>
</section>
</main>
<footer>© 2026 ardin.farhang. All rights reserved.<br>Desktop & Touch Ready • Pure HTML5 Engine</footer>
</div>
<script>
const home=document.getElementById('home'), game=document.getElementById('game'), canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');
const scoreEl=document.getElementById('score'),bestEl=document.getElementById('best'),homeBest=document.getElementById('homeBest'),overlay=document.getElementById('overlay'),overText=document.getElementById('overText');
let best=+localStorage.getItem('ardinBest')||0, score=0, running=false, bird, pipes=[], last=0, spawn=0, raf;
homeBest.textContent=best; bestEl.textContent=best;
function resize(){const r=canvas.getBoundingClientRect();canvas.width=r.width*devicePixelRatio;canvas.height=r.height*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0)} addEventListener('resize',resize);
function reset(){resize();score=0;scoreEl.textContent=0;bird={x:canvas.clientWidth*.25,y:canvas.clientHeight*.45,vy:0,r:15};pipes=[];spawn=0;overlay.style.display='none';running=true;last=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(loop)}
function flap(){if(!running){reset();return}bird.vy=-390}
function addPipe(){const h=canvas.clientHeight,gap=150,top=70+Math.random()*(h-240);pipes.push({x:canvas.clientWidth+30,top,bottom:top+gap,w:58,passed:false})}
function end(){running=false;overText.textContent='Score: '+score+(score>best?' • NEW BEST!':'');if(score>best){best=score;localStorage.setItem('ardinBest',best);bestEl.textContent=best;homeBest.textContent=best}overlay.style.display='grid'}
function draw(){const w=canvas.clientWidth,h=canvas.clientHeight;ctx.clearRect(0,0,w,h);
ctx.fillStyle='#fff';ctx.font='700 13px system-ui';ctx.fillText('ardin.farhang arcade',18,h-18);
pipes.forEach(p=>{ctx.fillStyle='#172018';ctx.fillRect(p.x,0,p.w,p.top);ctx.fillRect(p.x,p.bottom,p.w,h-p.bottom);ctx.fillStyle='#293b25';ctx.fillRect(p.x-4,p.top-12,p.w+8,12);ctx.fillRect(p.x-4,p.bottom,p.w+8,12)});
ctx.save();ctx.translate(bird.x,bird.y);ctx.rotate(Math.max(-.5,Math.min(.8,bird.vy/600)));ctx.fillStyle='#ffd34d';ctx.beginPath();ctx.arc(0,0,bird.r,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(6,-5,5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#111';ctx.beginPath();ctx.arc(8,-5,2,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ff8c42';ctx.beginPath();ctx.moveTo(13,0);ctx.lineTo(25,5);ctx.lineTo(13,8);ctx.closePath();ctx.fill();ctx.restore()}
function loop(t){if(!running)return;let dt=Math.min((t-last)/1000,.03);last=t;bird.vy+=1100*dt;bird.y+=bird.vy*dt;spawn+=dt;if(spawn>.002+1.55){addPipe();spawn=0}pipes.forEach(p=>p.x-=190*dt);
pipes.forEach(p=>{if(!p.passed&&p.x+p.w<bird.x){p.passed=true;score++;scoreEl.textContent=score}});
pipes=pipes.filter(p=>p.x+p.w>-10);let h=canvas.clientHeight;for(const p of pipes){if(bird.x+bird.r>p.x&&bird.x-bird.r<p.x+p.w&&(bird.y-bird.r<p.top||bird.y+bird.r>p.bottom))return end()}if(bird.y-bird.r<0||bird.y+bird.r>h-1)return end();draw();raf=requestAnimationFrame(loop)}
document.getElementById('play').onclick=()=>{home.style.display='none';game.style.display='block';reset()};
document.getElementById('again').onclick=reset;
document.getElementById('menu').onclick=()=>{running=false;game.style.display='none';home.style.display='block'};
addEventListener('keydown',e=>{if(e.code==='Space'){e.preventDefault();flap()}});
canvas.addEventListener('pointerdown',e=>{e.preventDefault();flap()});
</script>
</body></html>
